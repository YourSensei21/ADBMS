DROP TABLE IF EXISTS StudentEnrollments;
CREATE TABLE StudentEnrollments (
    enrollment_id INT PRIMARY KEY,
    student_name VARCHAR(100),
    course_id VARCHAR(10),
    enrollment_date DATE,
    CONSTRAINT uc_student_course UNIQUE (student_name, course_id)
);

-- Part A: Prevent Duplicate Enrollments Using Locking
START TRANSACTION;
INSERT INTO StudentEnrollments (enrollment_id, student_name, course_id, enrollment_date) VALUES (1, 'Ashish', 'CSE101', '2024-07-01');
COMMIT;


START TRANSACTION;

ROLLBACK;

-- Part B: Use SELECT FOR UPDATE to Lock Student Record
START TRANSACTION;
UPDATE StudentEnrollments SET enrollment_date = '2024-07-02' WHERE student_name = 'Ashish' AND course_id = 'CSE101';
COMMIT;

-- Part C: Demonstrate Locking Preserving Consistency in Concurrent Transactions
START TRANSACTION;
UPDATE StudentEnrollments SET enrollment_date = '2024-07-10' WHERE student_name = 'Ashish' AND course_id = 'CSE101';
COMMIT;


START TRANSACTION;
UPDATE StudentEnrollments SET enrollment_date = '2024-07-15' WHERE student_name = 'Ashish' AND course_id = 'CSE101';
COMMIT;

