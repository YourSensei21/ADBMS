-- Part A: Simulating a Deadlock Between Two Transactions
START TRANSACTION;
UPDATE StudentEnrollments SET course_id = 'CSE101-A' WHERE student_id = 1;
UPDATE StudentEnrollments SET course_id = 'CSE102-A' WHERE student_id = 2;
COMMIT;


DELETE FROM StudentEnrollments WHERE student_id != 1;
UPDATE StudentEnrollments SET course_id = 'CSE101', enrollment_date = '2024-06-01' WHERE student_id = 1;

-- Part B: Applying MVCC to Prevent Conflicts
START TRANSACTION;
UPDATE StudentEnrollments SET enrollment_date = '2024-07-10' WHERE student_id = 1;
COMMIT;

